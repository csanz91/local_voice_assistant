{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESP32 local provisioning configuration",
  "description": "Partial updates retain omitted NVS values. The UI fills defaults for most fields; omitted credentials and profiles stay omitted. Full command including prefix/newline must fit in 8191 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "sebastian.config.v1"
    },
    "mode": {
      "enum": [
        "full_duplex",
        "half_duplex"
      ]
    },
    "wifi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Maximum 32 UTF-8 bytes."
        },
        "password": {
          "type": "string",
          "maxLength": 64,
          "description": "Omit to keep stored password; empty selects open network. Maximum 64 UTF-8 bytes."
        }
      }
    },
    "livekit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenServerUrl": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^/@#\\s]+(?::[0-9]+)?(?:/[^#\\s]*)?$",
              "maxLength": 255
            }
          ],
          "description": "Complete session POST URL including path, maximum 255 UTF-8 bytes; no URL credentials or fragments. Firmware validates URL and TLS."
        },
        "allowInsecureHttp": {
          "type": "boolean",
          "default": false,
          "description": "Explicit local development opt-in. HTTP exposes device credentials in transit."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tokenServerUrl"
            ],
            "properties": {
              "tokenServerUrl": {
                "pattern": "^http://"
              }
            }
          },
          "then": {
            "required": [
              "allowInsecureHttp"
            ],
            "properties": {
              "allowInsecureHttp": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[!-~]*$",
          "description": "Omit to keep stored credential. Empty clears it; provision a voice-scoped device JWT before opening a session. Returned only by the physical USB pairing readback; kept out of automatic previews and logs."
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fullDuplex": {
          "type": "boolean"
        },
        "fixedBeam": {
          "type": "boolean"
        },
        "fixedBeamAzimuthDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "silenceTimeoutMs": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 120000
        },
        "voiceLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32767
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "syslogIp": {
          "type": "string",
          "description": "Optional IPv4 UDP syslog receiver. Empty disables remote logs."
        },
        "syslogPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 6,
      "description": "Stored JSON must fit in 1023 UTF-8 bytes. Empty array selects built-in profiles; omitted preserves current profiles. Names must be unique.",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "activeProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 23,
      "description": "Stored profile name, maximum 23 UTF-8 bytes. Omit to preserve existing selection."
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 23
        },
        "mode": {
          "enum": [
            "agent",
            "usb_mic",
            "gpt_live"
          ]
        },
        "beamAzimuthDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "fullDuplex": {
          "type": "boolean"
        },
        "fixedBeam": {
          "type": "boolean"
        },
        "wifi": {
          "type": "boolean"
        },
        "telemetry": {
          "type": "boolean"
        }
      }
    }
  }
}
