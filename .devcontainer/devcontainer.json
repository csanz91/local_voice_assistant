{
  "name": "Sebastian firmware",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ziglang.vscode-zig"
      ],
      "settings": {
        "zig.path": "/workspace/tools/zig.sh",
        "zig.formattingProvider": "extension",
        "zig.zls.enabled": false,
        "[zig]": {
          "editor.formatOnSave": true
        }
      }
    }
  }
}
